{
  // No hardcoded python.defaultInterpreterPath here: the venv layout differs
  // by OS (.venv/bin/python on macOS/Linux vs .venv\Scripts\python.exe on
  // Windows), and a path that doesn't resolve on your OS blocks the Python
  // extension entirely. After running the "backend: create venv + install
  // deps" task, use Ctrl+Shift+P -> "Python: Select Interpreter" and pick
  // the .venv one VS Code auto-detects.
  "python.envFile": "${workspaceFolder}/.env",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["-v"],
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  }
}
